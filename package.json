{
  "name": "mising-archives",
  "version": "1.0.0",
  "description": "A community-led initiative to preserve and share knowledge about Mising culture, tradition, history, and language",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-sitemap.js && node scripts/generate-llms.js",
    "thumbnails": "node scripts/generate-thumbnails.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npm run deploy:vercel"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^6.2.4",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "sharp": "^0.33.5",
    "vite": "^4.4.0"
  }
}
